<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>HydroFresh — Dashboard Toko Belanja</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: {
          display: ['"Space Grotesk"', 'sans-serif'],
          body: ['Inter', 'sans-serif'],
        },
      },
    },
  }
</script>
</head>

<body class="font-body bg-slate-950 text-slate-100 antialiased min-h-screen">

  <!-- NAVBAR APP -->
  <header class="sticky top-0 z-50 bg-slate-950/90 backdrop-blur-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-6 h-[72px] flex items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-emerald-500 flex items-center justify-center text-slate-950 text-lg font-bold">
          🌱
        </div>
        <span class="font-display font-bold text-white text-lg">Hydro<span class="text-emerald-400">Fresh Store</span></span>
      </a>

      <div class="flex items-center gap-4">
        <a href="/" class="text-xs text-slate-400 hover:text-white transition">← Kembali ke Landing</a>
        <div class="px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono font-bold">
          Panen Hari Ini Ready
        </div>
      </div>
    </div>
  </header>

  <!-- MAIN DASHBOARD CONTENT -->
  <main class="max-w-7xl mx-auto px-6 py-10 space-y-10">
    
    <!-- BANNER WELCOME -->
    <div class="bg-gradient-to-r from-emerald-900/40 via-slate-900 to-teal-900/30 border border-emerald-500/30 p-8 rounded-3xl flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
      <div>
        <span class="text-xs font-mono text-emerald-400 font-bold uppercase tracking-wider">Toko Online Resmi</span>
        <h1 class="font-display text-2xl sm:text-3xl font-bold text-white mt-1">Selamat Datang di Katalog HydroFresh</h1>
        <p class="text-xs text-slate-400 mt-1">Pilih sayuran segar bebas pestisida dan langsung lakukan checkout via WhatsApp.</p>
      </div>

      <div class="flex items-center gap-3 bg-slate-950 p-3 rounded-2xl border border-slate-800">
        <span class="text-2xl">👨‍🌾</span>
        <div class="text-left">
          <p class="text-xs font-bold text-white"><%= proposalData.author %></p>
          <p class="text-[10px] text-slate-400 font-mono"><%= proposalData.classInfo %></p>
        </div>
      </div>
    </div>

    <!-- SEARCH & KATALOG -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <h2 class="font-display text-xl font-bold text-white">Katalog Produk Sayuran</h2>
        <input type="text" id="searchInput" onkeyup="filterProducts()" placeholder="Cari selada, pakcoy..." class="bg-slate-900 border border-slate-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-emerald-500 w-full sm:w-64" />
      </div>

      <div id="productGrid" class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% products.forEach(p => { %>
          <div class="product-card bg-slate-900 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between hover:border-emerald-500/50 transition">
            <div>
              <div class="h-32 bg-slate-950 rounded-xl flex items-center justify-center text-5xl mb-4">
                <%= p.icon %>
              </div>
              <span class="text-[10px] font-mono bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded-full border border-emerald-500/20"><%= p.badge %></span>
              <h3 class="font-bold text-base text-white mt-2 product-title"><%= p.name %></h3>
              <p class="text-xs text-slate-400 mt-1"><%= p.desc %></p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-800 flex items-center justify-between">
              <div>
                <p class="text-[10px] text-slate-500">Harga / ikat</p>
                <p class="font-mono font-bold text-sm text-emerald-400">Rp <%= p.price.toLocaleString('id-ID') %></p>
              </div>
              <a href="https://wa.me/<%= proposalData.contactWA %>?text=Halo%20HydroFresh,%20saya%20mau%20pesan%20<%= encodeURIComponent(p.name) %>" target="_blank" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs px-4 py-2.5 rounded-xl transition">
                Beli WA
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="py-8 border-t border-slate-800 text-center text-xs text-slate-500 mt-12">
    <p>&copy; <%= new Date().getFullYear() %> HydroFresh Dashboard &middot; <%= proposalData.author %> (<%= proposalData.classInfo %>)</p>
  </footer>

  <script>
    function filterProducts() {
      const query = document.getElementById('searchInput').value.toLowerCase();
      const cards = document.querySelectorAll('.product-card');

      cards.forEach(card => {
        const title = card.querySelector('.product-title').textContent.toLowerCase();
        if (title.includes(query)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }
  </script>

</body>
</html>